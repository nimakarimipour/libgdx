        rotationChannel.data[i + ParticleChannels.ZOffset] = 0;
        rotationChannel.data[i + ParticleChannels.WOffset] = 1;
      }
    }

    for (int k = 0; k < velocities.size; ++k) {
      velocities.items[k].activateParticles(startIndex, count);
