        // put pivot in right position
        distances[si] = distances[i - 1];
        distances[i - 1] = pivot;
        particleIndices[si] = particleIndices[i - 1];
        particleIndices[i - 1] = particlesPivotIndex;

        // call qsort on right and left sides of pivot
        qsort(si, i - 2);
        qsort(i, ei);
      }
}
