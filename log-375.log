    regionHeight = sprite.regionHeight;
    originX = sprite.originX;
    originY = sprite.originY;
    rotation = sprite.rotation;
    scaleX = sprite.scaleX;
    scaleY = sprite.scaleY;
    color.set(sprite.color);
    dirty = sprite.dirty;
}
