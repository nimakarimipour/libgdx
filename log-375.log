      u2 = region.u;
      v2 = region.v2;
      u3 = region.u;
      v3 = region.v;
      u4 = region.u2;
      v4 = region.v;
    } else {
      u1 = region.u;
      v1 = region.v;
      u2 = region.u2;
      v2 = region.v;
      u3 = region.u2;
