    if (sprite == null) throw new IllegalArgumentException("sprite cannot be null.");
    System.arraycopy(sprite.vertices, 0, vertices, 0, SPRITE_SIZE);
    texture = sprite.texture;
    u = sprite.u;
    v = sprite.v;
    u2 = sprite.u2;
    v2 = sprite.v2;
    x = sprite.x;
