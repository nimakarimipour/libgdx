    vertices[idx + 1] = y1;
    vertices[idx + 2] = color;
    vertices[idx + 3] = u;
    vertices[idx + 4] = v;

    vertices[idx + 5] = x2;
    vertices[idx + 6] = y2;
    vertices[idx + 7] = color;
    vertices[idx + 8] = u;
    vertices[idx + 9] = v2;

    vertices[idx + 10] = x3;
    vertices[idx + 11] = y3;
    vertices[idx + 12] = color;
    vertices[idx + 13] = u2;
    vertices[idx + 14] = v2;

    vertices[idx + 15] = x4;
