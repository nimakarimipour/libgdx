      int columns = this.columns, rows = this.rows;
      float[] columnMinWidth = this.columnMinWidth = ensureSize(this.columnMinWidth, columns);
      float[] rowMinHeight = this.rowMinHeight = ensureSize(this.rowMinHeight, rows);
