              if (c.spaceTop == null) throw new IllegalArgumentException("spaceTop cannot be null.");
              if (above.spaceBottom != null) {
                  c.computedPadTop += Math.max(0, c.spaceTop.get(a) - above.spaceBottom.get(a));
              }
          }
          if (c.spaceRight == null) throw new IllegalArgumentException("spaceRight cannot be null.");
          if (c.padRight == null) throw new IllegalArgumentException("padRight cannot be null.");
