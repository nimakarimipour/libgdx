          if (a == null) throw new IllegalArgumentException("Actor a cannot be null.");
  
          if (c.expandY != 0 && expandHeight[row] == 0) expandHeight[row] = c.expandY;
          if (colspan == 1 && c.expandX != 0 && expandWidth[column] == 0) 
