          renderable.worldTransform.getTranslation(tmpV1);
          if (combinedAttributes.has(ColorAttribute.AmbientLight))
            cacheAmbientCubemap.set(
                ((ColorAttribute) combinedAttributes.get(ColorAttribute.AmbientLight)).color);

