              norms.add(Float.parseFloat(tokens[1]));
              norms.add(Float.parseFloat(tokens[2]));
              norms.add(Float.parseFloat(tokens[3]));
            } else if (tokens[0].charAt(1) == 't') {
              uvs.add(Float.parseFloat(tokens[1]));
