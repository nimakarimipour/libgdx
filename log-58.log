        tokens = line.split("\\s+");
        if (tokens.length < 1) break;

        if (tokens[0].length() == 0) {
          continue;
        } else if ((firstChar = tokens[0].toLowerCase().charAt(0)) == '#') {
          continue;
        } else if (firstChar == 'v') {
