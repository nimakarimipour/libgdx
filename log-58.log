          } else if (tokens[0].equals("mtllib")) {
            mtl.load(file.parent().child(tokens[1]));
          } else if (tokens[0].equals("usemtl")) {
            if (tokens.length == 1) activeGroup.materialName = "default";
            else activeGroup.materialName = tokens[1].replace('.', '_');
          }
