              verts.add(Float.parseFloat(tokens[2]));
              verts.add(Float.parseFloat(tokens[3]));
            } else if (tokens[0].charAt(1) == 'n') {
              norms.add(Float.parseFloat(tokens[1]));
              norms.add(Float.parseFloat(tokens[2]));
