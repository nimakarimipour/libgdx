public void load(BufferedReader reader) throws IOException {
      super.load(reader);
      // For backwards compatibility, independent property may not be defined
      if (reader.markSupported()) reader.mark(100);
      String line = reader.readLine();
      if (line == null) throw new IOException("Missing value: independent");
      if (line.contains("independent")) independent = Boolean.parseBoolean(readString(line));
      else if (reader.markSupported()) reader.reset();
      else {
        // @see java.io.BufferedReader#markSupported may return false in some platforms (such as
        // GWT),
        // in that case backwards commpatibility is not possible
        String errorMessage =
