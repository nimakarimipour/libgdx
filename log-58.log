          } else if (firstChar == 'v') {
            if (tokens[0].length() == 1) {
              verts.add(Float.parseFloat(tokens[1]));
              verts.add(Float.parseFloat(tokens[2]));
              verts.add(Float.parseFloat(tokens[3]));
