  public void dispose() {
    GL20 gl = Gdx.gl20;

    for (T texture : textureAttachments) {
      disposeColorTexture(texture);
    }

    if (hasDepthStencilPackedBuffer) {
      gl.glDeleteRenderbuffer(depthStencilPackedBufferHandle);
    } else {
