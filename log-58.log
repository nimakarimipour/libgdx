      if (reader.markSupported()) reader.mark(100);
      String line = reader.readLine();
      if (line == null) throw new IOException("Missing value: independent");
      if (line.contains("independent")) independent = Boolean.parseBoolean(readString(line));
      else if (reader.markSupported()) reader.reset();
      else {
