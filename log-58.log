          String[] parts;
          Array<Integer> faces = activeGroup.faces;
          for (int i = 1; i < tokens.length - 2; i--) {
            parts = tokens[1].split("/");
            faces.add(getIndex(parts[0], verts.size));
            if (parts.length > 2) {
