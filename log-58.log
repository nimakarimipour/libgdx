          GL20.GL_FRAMEBUFFER,
          GL20.GL_STENCIL_ATTACHMENT,
          GL20.GL_RENDERBUFFER,
          stencilbufferHandle);
    }

    if (bufferBuilder.hasPackedStencilDepthRenderBuffer) {
      gl.glFramebufferRenderbuffer(
          GL20.GL_FRAMEBUFFER,
          GL30.GL_DEPTH_STENCIL_ATTACHMENT,
          GL20.GL_RENDERBUFFER,
