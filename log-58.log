      gl.glBindRenderbuffer(GL20.GL_RENDERBUFFER, 0);

      gl.glFramebufferRenderbuffer(
          GL20.GL_FRAMEBUFFER,
          GL20.GL_DEPTH_ATTACHMENT,
          GL20.GL_RENDERBUFFER,
          depthStencilPackedBufferHandle);
      gl.glFramebufferRenderbuffer(
          GL20.GL_FRAMEBUFFER,
