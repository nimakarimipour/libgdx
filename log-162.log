      positionOffset = mesh.getVertexAttribute(Usage.Position).offset / FLOAT_BYTES;

    // Normal
    int normalOffset = -1;
    if (mesh.getVertexAttribute(Usage.Normal) != null)
      normalOffset = mesh.getVertexAttribute(Usage.Normal).offset / FLOAT_BYTES;

    // Tangent
