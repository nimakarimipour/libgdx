              this.getWidth()
                  - (style.background != null
                      ? style.background.getLeftWidth() + style.background.getRightWidth()
                      : 0);
          linesBreak.clear();
          int lineStart = 0;
          int lastSpace = 0;
          char lastCharacter;
          Pool<GlyphLayout> layoutPool = Pools.get(GlyphLayout.class);
          GlyphLayout layout = layoutPool.obtain();
          for (int i = 0; i < text.length(); i++) {
