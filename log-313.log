          int lastSpace = 0;
          char lastCharacter;
          Pool<GlyphLayout> layoutPool = Pools.get(GlyphLayout.class);
          GlyphLayout layout = layoutPool.obtain();
          for (int i = 0; i < text.length(); i++) {
