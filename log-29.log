public Task scheduleTask(Task task, float delaySeconds, float intervalSeconds, int repeatCount) {
    synchronized (threadLock) {
      synchronized (this) {
        synchronized (task) {
          if (task.timer != null)
            throw new IllegalArgumentException("The same task may not be scheduled twice.");
