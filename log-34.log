public BoundingBox extendBoundingBox(final BoundingBox out, boolean transform) {
      final int partCount = parts.size;
      for (int i = 0; i < partCount; i++) {
        final NodePart part = parts.get(i);
        if (part.enabled) {
          final MeshPart meshPart = part.meshPart;
