      }

      renderable.meshPart.size = (addedVertexCount / 4) * 6;
      renderable.meshPart.mesh.setVertices(
          vertices, currentVertexSize * v, currentVertexSize * addedVertexCount);
      renderable.meshPart.update();
      renderables.add(renderable);
    }
  }
