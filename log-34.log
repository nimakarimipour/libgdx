              + "Coord texCoord0\n"; // FIXME implement UV mapping
    }
    if ((attributesMask & TextureAttribute.Reflection) == TextureAttribute.Reflection) {
      prefix += "#define " + TextureAttribute.ReflectionAlias + "Flag\n";
      prefix +=
