public boolean isDescendantOf(Actor actor) {
    if (actor == null) throw new IllegalArgumentException("actor cannot be null.");
    Actor parent = this;
    do {
      if (parent == actor) return true;
      parent = parent.parent;
    } while (parent != null);
    return false;
