                      "Error Reading TMX Layer Data: Premature end of tile data");
                ids[y * width + x] =
                    unsignedByteToInt(temp[0])
                        | unsignedByteToInt(temp[1]) << 8
                        | unsignedByteToInt(temp[2]) << 16
                        | unsignedByteToInt(temp[3]) << 24;
