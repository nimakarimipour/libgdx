    if (mapOrientation != null) {
      if ("staggered".equals(mapOrientation)) {
        if (mapHeight > 1) {
          this.mapWidthInPixels += tileWidth / 2;
          this.mapHeightInPixels = mapHeightInPixels / 2 + tileHeight / 2;
