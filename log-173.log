  public void begin(final VertexAttributes attributes, int primitiveType) {
    if (this.attributes != null) throw new RuntimeException("Call end() first");
    this.attributes = attributes;
    this.vertices.clear();
    this.indices.clear();
    this.parts.clear();
    this.vindex = 0;
    this.lastIndex = -1;
    this.istart = 0;
