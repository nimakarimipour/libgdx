              try {
                Class type = json.getClass(valueMap.name());
                if (type == null) type = ClassReflection.forName(valueMap.name());
                readNamedObjects(json, type, valueMap);
              } catch (ReflectionException ex) {
                throw new SerializationException(ex);
              }
