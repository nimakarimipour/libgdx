          if ((!newLines || outputType != OutputType.minimal) && child.next != null)
            writer.append(',');
          writer.append(newLines ? '\n' : ' ');
        }
        if (newLines) indent(indent - 1, writer);
        writer.append('}');
      }
    } else if (object.isArray()) {
