        builder.line(tmpV0, tmpV2);
      }

      if (tangentOffset != -1) {
        builder.setColor(tangentColor);
        builder.line(tmpV0, tmpV4);
      }

      if (binormalOffset != -1) {
        builder.setColor(binormalColor);
        builder.line(tmpV0, tmpV6);
      }
