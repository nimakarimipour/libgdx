class com.badlogic.gdx.graphics.g3d.utils.shapebuilders.RenderableShapeBuilder {
public static void buildNormals(
      MeshPartBuilder builder,
      RenderableProvider renderableProvider,
      float vectorSize,
      Color normalColor,
      Color tangentColor,
      Color binormalColor) {

    renderableProvider.getRenderables(renderables, renderablesPool);

    for (Renderable renderable : renderables) {
      buildNormals(builder, renderable, vectorSize, normalColor, tangentColor, binormalColor);
    }

    renderablesPool.flush();
    renderables.clear();
}
}
