      minY = minY > vertices[i + 1] ? vertices[i + 1] : minY;
      maxX = maxX < vertices[i] ? vertices[i] : maxX;
      maxY = maxY < vertices[i + 1] ? vertices[i + 1] : maxY;
    }

    if (bounds == null) bounds = new Rectangle();
    bounds.x = minX;
    bounds.y = minY;
    bounds.width = maxX - minX;
    bounds.height = maxY - minY;

    return bounds;
