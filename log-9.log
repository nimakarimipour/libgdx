                long time = Gdx.input.getCurrentEventTime();
                if (time - touchDownTime <= maxFlingDelay) {
                  tracker.update(x, y, time);
                  handled = listener.fling(tracker.getVelocityX(), tracker.getVelocityY(), button) || handled;
                }
              }
