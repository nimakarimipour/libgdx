              total - (round ? Math.round(beforeWidth - knobWidthHalf) : beforeWidth - knobWidthHalf),
              knobAfter.getMinHeight());
        }
        if (currentKnob != null) {
          float w = currentKnob.getMinWidth(), h = currentKnob.getMinHeight();
          drawRound(
              batch,
              currentKnob, //
              x + position + (knobWidth - w) * 0.5f, //
              y + (height - h) * 0.5f, //
              w,
              h);
